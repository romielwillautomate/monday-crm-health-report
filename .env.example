# monday.com API (profile picture → Developers → API token → Show)
MONDAY_API_TOKEN=your-monday-personal-api-token
# Optional, default 2026-07 (the version this workflow was tested against)
MONDAY_API_VERSION=2026-07

# The boards to check, as one line of JSON. See the README for every field.
BOARDS_JSON=[{"id":"1234567890","name":"Sales Pipeline","required_columns":["email","phone","text_company"],"email_column":"email","phone_column":"phone","status_column":"status","owner_column":"person","done_labels":["Closed Won","Closed Lost"]}]

# Optional tuning
STALE_DAYS=30
MONDAY_PAGE_SIZE=100
MONDAY_MAX_PAGES=200
MONDAY_MAX_TRIES=3
MONDAY_MAX_WAIT_SECONDS=60
TOP_OFFENDERS=5
PHONE_DEFAULT_COUNTRY_CODE=1
# Time zone for the report date, for example America/New_York. Default: the n8n time zone.
REPORT_TIMEZONE=
# When the weekly run starts, in n8n's time zone. Default: Monday 08:00.
REPORT_CRON=0 8 * * 1

# Protects the Run Now webhook. Any long random string; send it in the X-Run-Secret header.
RUN_NOW_SECRET=make-up-a-long-random-string

# Optional: Slack incoming webhook for the report and for error alerts. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: HTML email through Resend (resend.com → API Keys, sending access). Leave REPORT_EMAIL_TO empty to skip email.
RESEND_API_KEY=re_your_resend_api_key
REPORT_EMAIL_FROM=CRM Reports <reports@example.com>
REPORT_EMAIL_TO=ops@example.com, sales.lead@example.com

# Optional: CRM Health Log board for trends. Leave HEALTH_LOG_BOARD_ID empty to skip it.
HEALTH_LOG_BOARD_ID=
HEALTH_LOG_COLUMNS={"key":"text_key","date":"date_snapshot","board":"text_board","score":"numbers_score","items":"numbers_items","issues":"numbers_issues","duplicates":"numbers_dupes","missing":"numbers_missing","stale":"numbers_stale","no_owner":"numbers_owner","invalid":"numbers_invalid"}
HEALTH_LOG_GROUP_ID=

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
